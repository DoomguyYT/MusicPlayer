<Window x:Class="MusicPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:MusicPlayer.Converters"
        xmlns:local="clr-namespace:MusicPlayer.ViewModels"
         Title="🎵 Music Player" 
        Height="750" Width="946"
        WindowStartupLocation="CenterScreen"
        Background="#1a1a2e"
        Closing="Window_Closing"
        Drop="Window_Drop"
        DragEnter="Window_DragEnter"
        DragLeave="Window_DragLeave">

    <Window.Resources>
        <converters:ItemIndexConverter x:Key="ItemIndexConverter" />
        <converters:PlayPauseConverter x:Key="PlayPauseConverter" />
        <converters:BooleanToColorConverter x:Key="BooleanToColorConverter" />
        <converters:BooleanColorConverter x:Key="BooleanColorConverter" />
    </Window.Resources>

    <Window.DataContext>
        <local:MainViewModel />
    </Window.DataContext>

    <DockPanel>
        <!-- Меню -->
        <Menu DockPanel.Dock="Top" Background="#2a2a4a" Foreground="Black" FontSize="13">
            <MenuItem Header="📁 Файл">
                <MenuItem Header="📂 Открыть файлы" Click="OpenFileMenuItem_Click" InputGestureText="Ctrl+O"/>
                <MenuItem Header="📁 Открыть папку" Click="OpenFolderMenuItem_Click" InputGestureText="Ctrl+F"/>
                <Separator/>
                <MenuItem Header="🧹 Очистить плейлист" Click="ClearPlaylistMenuItem_Click"/>
                <Separator/>
                <MenuItem Header="❌ Выход" Click="ExitMenuItem_Click" InputGestureText="Alt+F4"/>
            </MenuItem>
            <MenuItem Header="🌐 Интернет-радио">
                <MenuItem Header="🎵 Добавить URL" Click="AddStreamUrlMenuItem_Click" InputGestureText="Ctrl+U"/>
                <Separator/>
                <MenuItem Header="📻 Радиостанции">
                    <MenuItem Header="🎶 Radio Record" Click="RadioRecord_Click"/>
                    <MenuItem Header="🎵 Europa Plus" Click="EuropaPlus_Click"/>
                    <MenuItem Header="🎤 Русское Радио" Click="RusskoeRadio_Click"/>
                    <MenuItem Header="🎸 Rock FM" Click="RockFM_Click"/>
                    <MenuItem Header="💃 DFM" Click="DFM_Click"/>
                    <MenuItem Header="❤️ Love Radio" Click="LoveRadio_Click"/>
                    <MenuItem Header="🔥 Хит FM" Click="HitFM_Click"/>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="ℹ️ Помощь">
                <MenuItem Header="📖 О программе" Click="AboutMenuItem_Click"/>
            </MenuItem>
        </Menu>

        <!-- Основной контент -->
        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- ===== Верхняя панель ===== -->
            <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,10">
                <Button Content="📂 Открыть файлы" Command="{Binding OpenFileCommand}" 
                        Padding="10" Background="#6C63FF" Foreground="White" BorderThickness="0"/>
                <Button Content="📁 Открыть папку" Command="{Binding OpenFolderCommand}" 
                        Padding="10" Margin="10,0,0,0" Background="#6C63FF" Foreground="White" BorderThickness="0"/>
                <Button Content="➕ Плейлист" Command="{Binding CreatePlaylistCommand}" 
                        Padding="10" Margin="10,0,0,0" Background="#6C63FF" Foreground="White" BorderThickness="0"/>

                <StackPanel Orientation="Horizontal" Margin="20,0,0,0">
                    <TextBox x:Name="SearchTextBox" 
                             Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                             Width="180" Padding="8"
                             Background="#2a2a4a" Foreground="White" 
                             BorderBrush="#6C63FF" BorderThickness="2"
                             ToolTip="Поиск..."/>
                    <Button Content="✕" Width="30" Margin="5,0,0,0"
                            Background="Transparent" Foreground="#a0a0b0" BorderThickness="0"
                            Cursor="Hand" Click="ClearSearchButton_Click"/>
                </StackPanel>
            </StackPanel>

            <!-- ===== Информация о текущем потоке ===== -->
            <Border Grid.Row="1" Grid.ColumnSpan="2" 
                    Background="#2a2a4a" 
                    Padding="10" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Иконка радио -->
                    <Border Grid.Column="0" Width="50" Height="50" 
                            Background="#6C63FF"
                            HorizontalAlignment="Left" VerticalAlignment="Center">
                        <TextBlock Text="📻" FontSize="24" 
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Информация о треке -->
                    <StackPanel Grid.Column="1" Margin="15,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="NowPlayingTitle" 
                                   Text="🎵 Ожидание воспроизведения..." 
                                   FontSize="16" FontWeight="Bold"
                                   Foreground="White"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="NowPlayingStation" 
                                   Text="Выберите радиостанцию или введите URL"
                                   FontSize="12"
                                   Foreground="#a0a0b0"/>
                    </StackPanel>

                    <!-- Индикатор статуса -->
                    <Border Grid.Column="2" 
                            Width="12" Height="12" 
                            x:Name="StreamStatusIndicator"
                            Background="#ff5f56"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Right">
                        <Border.ToolTip>
                            <ToolTip Content="Статус подключения"/>
                        </Border.ToolTip>
                    </Border>
                </Grid>
            </Border>

            <!-- ===== MediaElement (скрытый) ===== -->
            <MediaElement x:Name="StreamMediaElement" 
                          Grid.Row="2" Grid.ColumnSpan="2"
                          Visibility="Collapsed"
                          LoadedBehavior="Manual"
                          MediaOpened="StreamMediaElement_MediaOpened"
                          MediaFailed="StreamMediaElement_MediaFailed"
                          MediaEnded="StreamMediaElement_MediaEnded"/>

            <!-- ===== Список треков ===== -->
            <Border Grid.Row="2" Grid.Column="0" Background="#2a2a4a" Padding="10">
                <ListView x:Name="SongListView"
                          ItemsSource="{Binding CurrentPlaylist.Songs}" 
                          SelectedItem="{Binding CurrentSong}"
                          Background="Transparent" BorderThickness="0" 
                          FontSize="14" Foreground="White"
                          MouseDoubleClick="SongListView_MouseDoubleClick">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="Padding" Value="8"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#3a3a5a"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#6C63FF"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="#" Width="40">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ListViewItem}}, 
                                                          Converter={StaticResource ItemIndexConverter}}" 
                                                   Foreground="#a0a0b0"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Название" Width="200" DisplayMemberBinding="{Binding Title}"/>
                            <GridViewColumn Header="Исполнитель" Width="120" DisplayMemberBinding="{Binding Artist}"/>
                            <GridViewColumn Header="Альбом" Width="120" DisplayMemberBinding="{Binding Album}"/>
                            <GridViewColumn Header="Длительность" Width="70" DisplayMemberBinding="{Binding Duration}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Border>

            <!-- ===== Плейлисты ===== -->
            <Border Grid.Row="2" Grid.Column="1" Background="#2a2a4a" Padding="10" Margin="10,0,0,0">
                <ListView ItemsSource="{Binding Playlists}" 
                          SelectedItem="{Binding CurrentPlaylist}"
                          Background="Transparent" BorderThickness="0" 
                          FontSize="14" Foreground="White">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="Padding" Value="8"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#3a3a5a"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#6C63FF"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}"/>
                                <Button Grid.Column="1" Content="✕" Background="Transparent" BorderThickness="0" 
                                        Foreground="#ff5f56" Cursor="Hand"
                                        Command="{Binding DataContext.DeletePlaylistCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}}"
                                        CommandParameter="{Binding}"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

            <!-- ===== Управление ===== -->
            <Border Grid.Row="3" Grid.ColumnSpan="2" Background="#2a2a4a" Padding="10" Margin="0,10,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Кнопки управления -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Button Content="⏮" Command="{Binding PreviousCommand}" 
                                Width="40" Height="40" FontSize="18" Background="Transparent" Foreground="White" BorderThickness="0"/>
                        <Button Content="{Binding IsPlaying, Converter={StaticResource PlayPauseConverter}}" 
                                Command="{Binding PlayPauseCommand}" 
                                Width="50" Height="50" FontSize="24" 
                                Background="#6C63FF" Foreground="White" BorderThickness="0"/>
                        <Button Content="⏭" Command="{Binding NextCommand}" 
                                Width="40" Height="40" FontSize="18" Background="Transparent" Foreground="White" BorderThickness="0"/>
                        <Button Content="🔁" Command="{Binding ToggleRepeatCommand}" 
                                Width="40" Height="40" FontSize="16" Background="Transparent" 
                                Foreground="{Binding IsRepeatAll, Converter={StaticResource BooleanToColorConverter}}" BorderThickness="0"
                                ToolTip="Повтор"/>
                        <Button Content="🔀" Command="{Binding ToggleShuffleCommand}" 
                                Width="40" Height="40" FontSize="16" Background="Transparent" 
                                Foreground="{Binding IsShuffle, Converter={StaticResource BooleanColorConverter}}" BorderThickness="0"
                                ToolTip="Перемешать"/>
                    </StackPanel>

                    <!-- Прогресс-бар -->
                    <Grid Grid.Column="1" Margin="20,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="{Binding CurrentTime}" Foreground="#a0a0b0" VerticalAlignment="Center"/>

                        <Slider Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding Progress}" 
                                Margin="10,0" VerticalAlignment="Center"
                                x:Name="ProgressSlider"
                                Thumb.DragStarted="Slider_DragStarted" 
                                Thumb.DragCompleted="Slider_DragCompleted"
                                Foreground="#6C63FF"/>

                        <TextBlock Grid.Column="2" Text="{Binding TotalTime}" Foreground="#a0a0b0" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Громкость -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🔊" Foreground="#a0a0b0" Margin="0,0,5,0"/>
                        <Slider Width="80" Minimum="0" Maximum="1" Value="{Binding Volume}" 
                                x:Name="VolumeSlider"
                                Foreground="#6C63FF"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== Панель URL ===== -->
            <Border Grid.Row="4" Grid.ColumnSpan="2" Background="#2a2a4a" Padding="10" Margin="0,5,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="StreamUrlTextBox" 
                             Grid.Column="0"
                             Text="Введите URL аудио-потока..." 
                             Foreground="#a0a0b0" 
                             Background="Transparent" 
                             BorderBrush="#6C63FF" 
                             BorderThickness="1" 
                             Padding="10"
                             GotFocus="StreamUrlTextBox_GotFocus"
                             LostFocus="StreamUrlTextBox_LostFocus"/>

                    <Button Grid.Column="1" 
                            Content="▶ Воспроизвести поток" 
                            Margin="10,0,0,0"
                            Padding="15,10"
                            Background="#6C63FF" 
                            Foreground="White" 
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="PlayStreamButton_Click"/>
                </Grid>
            </Border>

            <!-- ===== Статус-бар ===== -->
            <TextBlock x:Name="StatusText" 
                       Grid.Row="5" Grid.ColumnSpan="2" 
                       Text="🎵 Готов к воспроизведению" 
                       Foreground="#a0a0b0" 
                       HorizontalAlignment="Center" 
                       Margin="0,5,0,0"/>
        </Grid>
    </DockPanel>
</Window>